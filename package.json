{
  "name": "slashbin-ai-team",
  "version": "3.0.0",
  "description": "Run a team of AI coworkers in Discord, each on Claude Code or Codex, with optional Paperclip board work. Safe enough to leave running.",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "discord",
    "discord-bot",
    "ai-agent",
    "ai-employee",
    "mcp",
    "chatops",
    "self-hosted"
  ],
  "homepage": "https://github.com/xrgarcia/slashbin-ai-team#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xrgarcia/slashbin-ai-team.git"
  },
  "bugs": {
    "url": "https://github.com/xrgarcia/slashbin-ai-team/issues"
  },
  "author": "Slashbin, LLC",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:fleet": "node scripts/doctor.mjs --fleet",
    "advise": "node scripts/upgrade-advisor.mjs",
    "start": "node bot-manager.mjs start",
    "stop": "node bot-manager.mjs stop",
    "restart": "node bot-manager.mjs restart",
    "status": "node bot-manager.mjs status",
    "logs": "node bot-manager.mjs logs",
    "signal": "node scripts/signal.mjs",
    "summarize": "node summarize.js",
    "summarize:dry": "node summarize.js --dry-run",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ws": "^8.20.0"
  }
}
